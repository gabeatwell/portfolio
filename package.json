{
    "$schema": "https://json.schemastore.org/package.json",
    "name": "portfolio",
    "version": "6.3.4",
    "private": true,
    "packageManager": "pnpm@11.17.0",
    "engines": {
        "node": ">=22.0.0",
        "npm": ">=10.0.0"
    },
    "scripts": {
        "dev": "vite dev --host --open",
        "build": "vite build",
        "postbuild": "node scripts/copy-404.js",
        "preview": "vite preview --host",
        "lint": "oxlint .",
        "format": "oxfmt --write .",
        "format:svelte": "prettier --write \"src/**/*.svelte\"",
        "test": "vitest",
        "test:run": "vitest run",
        "check": "svelte-check",
        "skills:add": "skills add https://github.com/greensock/gsap-skills",
        "logs": "wrangler tail --env production",
        "prepare": "husky"
    },
    "devDependencies": {
        "@sveltejs/adapter-cloudflare": "^8.0.0",
        "@sveltejs/kit": "^3.0.0",
        "@sveltejs/vite-plugin-svelte": "^7.0.0",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/svelte": "^5.3.1",
        "@testing-library/user-event": "^14.6.1",
        "@types/node": "^25.0.6",
        "@types/pulltorefreshjs": "^0.1.7",
        "@types/three": "^0.182.0",
        "@types/youtube": "^0.3.0",
        "@vite-pwa/assets-generator": "^0.2.4",
        "dompurify": "^3.4.16",
        "dotenv": "^16.4.5",
        "esbuild": "0.27.3",
        "gsap": "^3.14.2",
        "husky": "^9.1.7",
        "jsdom": "^28.1.0",
        "lightningcss": "^1.33.0",
        "mdsvex": "^0.11.2",
        "oxfmt": "^0.41.0",
        "oxlint": "^1.56.0",
        "prettier": "^3.2.5",
        "prettier-plugin-svelte": "^3.2.3",
        "pulltorefreshjs": "^0.1.22",
        "sharp": "^0.34.5",
        "skills": "^1.4.7",
        "svelte": "^5.57.1",
        "svelte-check": "^4.7.6",
        "svelte-language-server": "^0.18.4",
        "terser": "^5.46.0",
        "three": "^0.167.1",
        "typescript": "^6.0.3",
        "vite": "^8.0.12",
        "vitest": "^4.1.0",
        "wrangler": "^4.59.2"
    },
    "type": "module",
    "dependencies": {
        "@anyblades/blades": "^3.0.0",
        "@fortawesome/fontawesome-free": "^6.6.0",
        "copy-to-clipboard": "^3.3.3",
        "highlight.js": "^11.11.1",
        "isomorphic-dompurify": "^4.4.0",
        "lenis": "^1.3.26",
        "marked": "^18.0.4",
        "valibot": "^1.5.0"
    },
    "optionalDependencies": {
        "@img/sharp-win32-x64": "0.34.5"
    },
    "imports": {
        "#lib/*": "./src/lib/*",
        "#routes/*": "./src/routes/*"
    }
}
